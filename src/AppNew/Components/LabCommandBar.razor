@inject LabWorkspaceState State
@inject LabPlatform Platform
@implements IDisposable

<div class="lab-command-bar">
    @if (State.Busy)
    {
        <FluentButton Appearance="ButtonAppearance.Subtle"
                      Size="ButtonSize.Small"
                      Class="lab-compile"
                      Color="@Success"
                      IconStart="@(new Icons.Regular.Size20.ArrowSync())"
                      Loading="true"
                      Disabled="true"
                      Label="@(State.CompilerLoading ? "Loading compiler" : "Compiling")" />
    }
    else
    {
        <FluentButton Appearance="ButtonAppearance.Subtle"
                      Size="ButtonSize.Small"
                      Class="lab-compile"
                      Color="@Success"
                      IconStart="@(new Icons.Filled.Size20.Play())"
                      Label="Compile"
                      OnClick="State.CompileAsync" />
    }

    <span class="lab-vsep" aria-hidden="true"></span>

    <div aria-label="Compiler selection" style="display:flex;align-items:center;gap:4px;flex-shrink:0;">
        <FluentButton Id="lab-sdk"
                      Appearance="ButtonAppearance.Subtle"
                      Size="ButtonSize.Small"
                      IconStart="@(new Icons.Regular.Size20.Toolbox())"
                      IconEnd="@(new Icons.Regular.Size16.ChevronDown())"
                      @key="@($"sdk-{State.Sdk}")"
                      Label="@($"SDK: {State.Sdk}")" />
        <FluentMenu Trigger="lab-sdk">
            <FluentMenuList>
                <FluentMenuItem Role="MenuItemRole.Radio"
                                Checked="@(State.Sdk == "built-in")"
                                Label="built-in"
                                OnClick="@(() => State.ApplySdk("built-in"))" />
                <FluentDivider />
                @foreach (var sdk in State.AvailableSdks)
                {
                    <FluentMenuItem Role="MenuItemRole.Radio"
                                    Checked="@(State.Sdk == sdk.Value)"
                                    Label="@sdk.Label"
                                    OnClick="@(() => State.ApplySdk(sdk.Value))" />
                }
                <FluentDivider />
                <FluentMenuItem Label="More SDK versions…" OnClick="State.ShowSettingsAsync" />
            </FluentMenuList>
        </FluentMenu>

        <FluentButton Id="lab-roslyn"
                      Appearance="ButtonAppearance.Subtle"
                      Size="ButtonSize.Small"
                      IconStart="@(new Icons.Regular.Size20.CodeText())"
                      IconEnd="@(new Icons.Regular.Size16.ChevronDown())"
                      @key="@($"roslyn-{State.Roslyn}")"
                      Label="@($"Roslyn: {State.Roslyn}")" />
        <FluentMenu Trigger="lab-roslyn">
            <FluentMenuList>
                @foreach (var item in LabCatalog.CompilerRefs)
                {
                    <FluentMenuItem Role="MenuItemRole.Radio"
                                    Checked="@(State.Roslyn == item)"
                                    Label="@item"
                                    OnClick="@(() => State.SetRoslyn(item))" />
                }
                <FluentDivider />
                <FluentMenuItem Label="Version, PR, branch or build…" OnClick="State.ShowSettingsAsync" />
            </FluentMenuList>
        </FluentMenu>

        <FluentButton Id="lab-razor"
                      Appearance="ButtonAppearance.Subtle"
                      Size="ButtonSize.Small"
                      IconStart="@(new Icons.Regular.Size20.CodeBlock())"
                      IconEnd="@(new Icons.Regular.Size16.ChevronDown())"
                      @key="@($"razor-{State.Razor}")"
                      Label="@($"Razor: {State.Razor}")" />
        <FluentMenu Trigger="lab-razor">
            <FluentMenuList>
                @foreach (var item in LabCatalog.CompilerRefs)
                {
                    <FluentMenuItem Role="MenuItemRole.Radio"
                                    Checked="@(State.Razor == item)"
                                    Label="@item"
                                    OnClick="@(() => State.SetRazor(item))" />
                }
                <FluentDivider />
                @foreach (var item in LabCatalog.RazorToolchains)
                {
                    <FluentMenuItem Label="@($"Toolchain: {item}")" OnClick="@(() => { State.RazorToolchain = item; State.Notify(); })" />
                }
                <FluentDivider />
                @foreach (var item in LabCatalog.RazorStrategies)
                {
                    <FluentMenuItem Label="@($"Strategy: {item}")" OnClick="@(() => { State.RazorStrategy = item; State.Notify(); })" />
                }
            </FluentMenuList>
        </FluentMenu>
    </div>

    <span class="lab-spacer"></span>
    <span class="lab-vsep" aria-hidden="true"></span>

    <div aria-label="Workspace commands" style="display:flex;align-items:center;gap:4px;flex-shrink:0;">
        <FluentButton Id="lab-cmd-palette"
                      Appearance="ButtonAppearance.Subtle"
                      Size="ButtonSize.Small"
                      IconOnly="true"
                      Title="@Platform.PaletteLabel"
                      AriaLabel="@Platform.PaletteLabel"
                      IconStart="@(new Icons.Regular.Size20.KeyCommand())"
                      OnClick="State.ShowPaletteAsync" />
        <FluentTooltip Anchor="lab-cmd-palette"
                       Class="lab-command-tooltip"
                       Positioning="Positioning.Below"
                       UseTooltipService="false">
            @Platform.PaletteLabel
        </FluentTooltip>
        <FluentButton Id="lab-cmd-keyboard"
                      Appearance="ButtonAppearance.Subtle"
                      Size="ButtonSize.Small"
                      IconOnly="true"
                      Class="@(State.DisableInputVirtualKeyboard ? "lab-toolbar-toggle-on" : null)"
                      Title="@(State.DisableInputVirtualKeyboard ? "Show on-screen keyboard" : "Hide on-screen keyboard")"
                      AriaLabel="@(State.DisableInputVirtualKeyboard ? "Show on-screen keyboard" : "Hide on-screen keyboard")"
                      IconStart="@(State.DisableInputVirtualKeyboard ? new Icons.Regular.Size20.KeyboardOff() : new Icons.Regular.Size20.Keyboard())"
                      OnClick="State.ToggleInputVirtualKeyboard" />
        <FluentTooltip Anchor="lab-cmd-keyboard"
                       Class="lab-command-tooltip"
                       Positioning="Positioning.Below"
                       UseTooltipService="false">
            @(State.DisableInputVirtualKeyboard ? "Show on-screen keyboard" : "Hide on-screen keyboard")
        </FluentTooltip>
        <FluentButton Id="lab-cmd-layout"
                      Appearance="ButtonAppearance.Subtle"
                      Size="ButtonSize.Small"
                      IconOnly="true"
                      Title="@(State.Stacked ? "Show panes side by side" : "Stack panes vertically")"
                      AriaLabel="@(State.Stacked ? "Show panes side by side" : "Stack panes vertically")"
                      IconStart="@(State.Stacked ? new Icons.Regular.Size20.LayoutColumnTwo() : new Icons.Regular.Size20.LayoutRowTwo())"
                      OnClick="State.ToggleStacked" />
        <FluentTooltip Anchor="lab-cmd-layout"
                       Class="lab-command-tooltip"
                       Positioning="Positioning.Below"
                       UseTooltipService="false">
            @(State.Stacked ? "Show panes side by side" : "Stack panes vertically")
        </FluentTooltip>
    </div>
</div>

@code {
    private const string Success = "#6ecf97";

    protected override void OnInitialized() => State.Changed += OnStateChanged;

    protected override Task OnInitializedAsync() => State.EnsureSdkVersionsAsync();

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnStateChanged;
}
