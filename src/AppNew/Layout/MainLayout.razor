@inherits LayoutComponentBase
@inject LabThemeService Theme
@inject LabWorkspaceState State
@inject LabUrlSync Urls
@inject LabPlatform Platform
@inject IUpdateChecker Updates
@inject IJSRuntime JS
@implements IDisposable

<div class="lab-shell">
    <div class="lab-app">
        @if (_ready)
        {
            <header aria-label="Application commands">
                <LabBrandBar />
                <LabCommandBar />
            </header>
            @Body
            <SettingsDialog @ref="_settings" />
            <CommandPalette @ref="_palette" />
            <PasteUrlDialog @ref="_paste" />
        }
    </div>
</div>

<!--<FluentProviders />-->

@code {
    private SettingsDialog? _settings;
    private CommandPalette? _palette;
    private PasteUrlDialog? _paste;
    private bool _ready;

    protected override void OnInitialized()
    {
        State.SettingsRequested += OpenSettingsAsync;
        State.PaletteRequested += TogglePaletteAsync;
        State.PasteUrlRequested += OpenPasteAsync;
        Updates.UpdateStatusChanged += OnUpdatesChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Theme.InitializeAsync();
        await Platform.InitializeAsync();
        try
        {
            await Updates.InitializeAsync();
        }
        catch (JSException)
        {
        }

        await State.LoadSettingsAsync();
        try
        {
            var json = await JS.InvokeAsync<string>("netLabPrefs.readOutputTabs");
            State.ApplySavedOutputTabs(json);
        }
        catch (JSException)
        {
        }

        await Urls.LoadFromUriAsync();
        _ready = true;
        StateHasChanged();
    }

    private void OnUpdatesChanged() => InvokeAsync(StateHasChanged);

    private Task OpenSettingsAsync() => _settings?.ShowAsync() ?? Task.CompletedTask;

    private Task TogglePaletteAsync() => _palette?.ToggleAsync() ?? Task.CompletedTask;

    private Task OpenPasteAsync() => _paste?.ShowAsync() ?? Task.CompletedTask;

    public void Dispose()
    {
        State.SettingsRequested -= OpenSettingsAsync;
        State.PaletteRequested -= TogglePaletteAsync;
        State.PasteUrlRequested -= OpenPasteAsync;
        Updates.UpdateStatusChanged -= OnUpdatesChanged;
    }
}
