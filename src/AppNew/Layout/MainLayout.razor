@inherits LayoutComponentBase
@inject LabThemeService Theme
@inject LabWorkspaceState Workspace
@inject LabUrlSync Urls
@inject LabPlatform Platform
@inject ILabEnvironment Environment
@inject IDispatcher Dispatcher
@implements IDisposable

<div class="lab-shell">
    <div class="lab-app">
        @if (_ready)
        {
            <header aria-label="Application commands">
                <LabBrandBar />
                <LabCommandBar />
            </header>
            @Body
            <SettingsDialog @ref="_settings" />
            <CommandPalette @ref="_palette" />
            <PasteUrlDialog @ref="_paste" />
        }
    </div>
</div>

<!--<FluentProviders />-->

@code {
    private SettingsDialog? _settings;
    private CommandPalette? _palette;
    private PasteUrlDialog? _paste;
    private bool _ready;

    protected override void OnInitialized()
    {
        Workspace.SettingsRequested += OpenSettingsAsync;
        Workspace.PaletteRequested += TogglePaletteAsync;
        Workspace.PasteUrlRequested += OpenPasteAsync;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            Dispatcher.Dispatch(new SeedPreferencesAction(Environment.IsDevelopment));
            await Theme.InitializeAsync();
            await Platform.InitializeAsync();
            Dispatcher.Dispatch(new InitializeUpdatesAction());
            await Workspace.LoadSettingsAsync();
            await Urls.LoadFromUriAsync();
        }
        finally
        {
            _ready = true;
            StateHasChanged();
        }
    }

    private Task OpenSettingsAsync() => _settings?.ShowAsync() ?? Task.CompletedTask;

    private Task TogglePaletteAsync() => _palette?.ToggleAsync() ?? Task.CompletedTask;

    private Task OpenPasteAsync() => _paste?.ShowAsync() ?? Task.CompletedTask;

    public void Dispose()
    {
        Workspace.SettingsRequested -= OpenSettingsAsync;
        Workspace.PaletteRequested -= TogglePaletteAsync;
        Workspace.PasteUrlRequested -= OpenPasteAsync;
    }
}
