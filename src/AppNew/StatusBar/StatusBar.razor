@inject ILabStatus Status
@implements IDisposable

<div class="lab-statusbar">
    @foreach (var (item, index) in Left.Select((value, i) => (value, i)))
    {
        <span class="@(index == 0 ? "primary" : null)">@item</span>
    }
    <span class="lab-spacer"></span>
    <span class="lab-status-pill">
        <span class="lab-dot @(Ready ? null : "stale")"></span>
        @Right
    </span>
</div>

@code {
    [Parameter] public string Side { get; set; } = "source";

    private IReadOnlyList<string> Left => Side == "output" ? Status.OutputStatusLeft : Status.SourceStatusLeft;
    private string Right => Side == "output" ? Status.OutputStatusRight : Status.SourceStatusRight;
    private bool Ready => Side == "output" ? Status.OutputReady : Status.SourceReady;

    protected override void OnInitialized() => Status.Changed += OnChanged;

    public void Dispose() => Status.Changed -= OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);
}
