@inject LabWorkspaceState State
@implements IDisposable

<div class="lab-statusbar">
    @foreach (var (item, index) in Left.Select((value, i) => (value, i)))
    {
        <span class="@(index == 0 ? "primary" : null)">@item</span>
    }
    <span class="lab-spacer"></span>
    <span class="lab-status-pill">
        <span class="lab-dot @(Ready ? null : "stale")"></span>
        @Right
    </span>
</div>

@code {
    [Parameter] public string Side { get; set; } = "source";

    private IReadOnlyList<string> Left => Side == "output" ? State.OutputStatusLeft : State.SourceStatusLeft;
    private string Right => Side == "output" ? State.OutputStatusRight : State.SourceStatusRight;
    private bool Ready => Side == "output" ? !State.Running : !State.Stale && !State.Running;

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        State.StatusChanged += OnChanged;
    }

    public void Dispose()
    {
        State.Changed -= OnChanged;
        State.StatusChanged -= OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
}
