@inject ILabCommands Commands
@inject LabPlatform Platform
@implements IDisposable

<div class="lab-command-bar">
    @if (Commands.Busy)
    {
        <FluentButton Appearance="ButtonAppearance.Subtle"
                      Size="ButtonSize.Small"
                      Class="lab-compile"
                      Color="@Success"
                      IconStart="@(new Icons.Regular.Size20.ArrowSync())"
                      Loading="true"
                      Disabled="true"
                      Label="@(Commands.CompilerLoading ? "Loading compiler" : "Compiling")" />
    }
    else
    {
        <FluentButton Appearance="ButtonAppearance.Subtle"
                      Size="ButtonSize.Small"
                      Class="lab-compile"
                      Color="@Success"
                      IconStart="@(new Icons.Filled.Size20.Play())"
                      Label="Compile"
                      OnClick="Commands.CompileAsync" />
    }

    <span class="lab-vsep" aria-hidden="true"></span>

    <div aria-label="Compiler selection" style="display:flex;align-items:center;gap:4px;flex-shrink:0;">
        <CompilerPicker Id="lab-sdk"
                        Label="SDK"
                        Value="@Commands.Sdk"
                        IconStart="@(new Icons.Regular.Size20.Toolbox())"
                        Options="@SdkOptions"
                        Selected="Commands.ApplySdk">
            <Trailing>
                <FluentMenuItem Label="More SDK versions…" OnClick="Commands.ShowSettingsAsync" />
            </Trailing>
        </CompilerPicker>

        <CompilerPicker Id="lab-roslyn"
                        Label="Roslyn"
                        Value="@Commands.Roslyn"
                        IconStart="@(new Icons.Regular.Size20.CodeText())"
                        Options="@CompilerRefOptions"
                        Selected="Commands.SetRoslyn">
            <Trailing>
                <FluentMenuItem Label="Version, PR, branch or build…" OnClick="Commands.ShowSettingsAsync" />
            </Trailing>
        </CompilerPicker>

        <CompilerPicker Id="lab-razor"
                        Label="Razor"
                        Value="@Commands.Razor"
                        IconStart="@(new Icons.Regular.Size20.CodeBlock())"
                        Options="@CompilerRefOptions"
                        Selected="Commands.SetRazor">
            <Trailing>
                @foreach (var item in LabCatalog.RazorToolchains)
                {
                    <FluentMenuItem Label="@($"Toolchain: {item}")" OnClick="@(() => Commands.SetRazorToolchain(item))" />
                }
                <FluentDivider />
                @foreach (var item in LabCatalog.RazorStrategies)
                {
                    <FluentMenuItem Label="@($"Strategy: {item}")" OnClick="@(() => Commands.SetRazorStrategy(item))" />
                }
            </Trailing>
        </CompilerPicker>
    </div>

    <span class="lab-spacer"></span>
    @if (Commands.MemoryUsageView)
    {
        <MemoryUsageView />
        <span class="lab-vsep" aria-hidden="true"></span>
    }

    <div aria-label="Workspace commands" style="display:flex;align-items:center;gap:4px;flex-shrink:0;">
        <FluentButton Id="lab-cmd-palette"
                      Appearance="ButtonAppearance.Subtle"
                      Size="ButtonSize.Small"
                      IconOnly="true"
                      Title="@Platform.PaletteLabel"
                      AriaLabel="@Platform.PaletteLabel"
                      IconStart="@(new Icons.Regular.Size20.KeyCommand())"
                      OnClick="Commands.ShowPaletteAsync" />
        <FluentTooltip Anchor="lab-cmd-palette"
                       Class="lab-command-tooltip"
                       Positioning="Positioning.Below"
                       UseTooltipService="false">
            @Platform.PaletteLabel
        </FluentTooltip>
        <FluentButton Id="lab-cmd-keyboard"
                      Appearance="ButtonAppearance.Subtle"
                      Size="ButtonSize.Small"
                      IconOnly="true"
                      Class="@(Commands.DisableInputVirtualKeyboard ? "lab-toolbar-toggle-on" : null)"
                      Title="@(Commands.DisableInputVirtualKeyboard ? "Show on-screen keyboard" : "Hide on-screen keyboard")"
                      AriaLabel="@(Commands.DisableInputVirtualKeyboard ? "Show on-screen keyboard" : "Hide on-screen keyboard")"
                      IconStart="@(Commands.DisableInputVirtualKeyboard ? new Icons.Regular.Size20.KeyboardOff() : new Icons.Regular.Size20.Keyboard())"
                      OnClick="Commands.ToggleInputVirtualKeyboard" />
        <FluentTooltip Anchor="lab-cmd-keyboard"
                       Class="lab-command-tooltip"
                       Positioning="Positioning.Below"
                       UseTooltipService="false">
            @(Commands.DisableInputVirtualKeyboard ? "Show on-screen keyboard" : "Hide on-screen keyboard")
        </FluentTooltip>
        <FluentButton Id="lab-cmd-layout"
                      Appearance="ButtonAppearance.Subtle"
                      Size="ButtonSize.Small"
                      IconOnly="true"
                      Title="@(Commands.Stacked ? "Show panes side by side" : "Stack panes vertically")"
                      AriaLabel="@(Commands.Stacked ? "Show panes side by side" : "Stack panes vertically")"
                      IconStart="@(Commands.Stacked ? new Icons.Regular.Size20.LayoutColumnTwo() : new Icons.Regular.Size20.LayoutRowTwo())"
                      OnClick="Commands.ToggleStacked" />
        <FluentTooltip Anchor="lab-cmd-layout"
                       Class="lab-command-tooltip"
                       Positioning="Positioning.Below"
                       UseTooltipService="false">
            @(Commands.Stacked ? "Show panes side by side" : "Stack panes vertically")
        </FluentTooltip>
    </div>
</div>

@code {
    private const string Success = "#6ecf97";

    private static readonly CompilerPickerOption[] CompilerRefOptions =
        [.. LabCatalog.CompilerRefs.Select(item => new CompilerPickerOption(item, item))];

    private IReadOnlyList<CompilerPickerOption> SdkOptions
    {
        get
        {
            var options = new List<CompilerPickerOption> { new("built-in", "built-in") };
            var first = true;
            foreach (var sdk in Commands.AvailableSdks)
            {
                options.Add(new(sdk.Value, sdk.Label, DividerBefore: first));
                first = false;
            }

            return options;
        }
    }

    protected override void OnInitialized() => Commands.Changed += OnStateChanged;

    protected override Task OnInitializedAsync() => Commands.EnsureSdkVersionsAsync();

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Commands.Changed -= OnStateChanged;
}
